# --- from the candidate pack ---
DATABASE_URL=postgresql://oxide:oxide_dev@localhost:55432/oxide_monitor
BOT_SIMULATOR_URL=http://localhost:8788
PORT=3001

# --- auth (dev placeholders only - generate your own, never commit real values) ---
ADMIN_TOKEN=change-me-admin-token
AGENT_TOKEN=change-me-agent-token

# --- order / heartbeat tuning (milliseconds) ---
HEARTBEAT_TIMEOUT_MS=10000
ORDER_REQUEUE_AFTER_MS=20000
ORDER_MAX_PROCESSING_MS=300000
ORDER_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=2000
RETRY_SAME_BOT_AFTER_MS=10000
COMMAND_TIMEOUT_MS=15000
MONITOR_INTERVAL_MS=2000

# --- code deployment packages ---
DEPLOY_STORAGE_DIR=./storage/deployments
MAX_UPLOAD_MB=50

# --- bot agent (agent/bot-agent.ts) ---
BACKEND_WS_URL=ws://localhost:3001/ws/agent
BACKEND_HTTP_URL=http://localhost:3001
AGENT_HEARTBEAT_INTERVAL_MS=3000
AGENT_FAIL_RATE=0.15
AGENT_WORK_MIN_MS=3000
AGENT_WORK_MAX_MS=7000
