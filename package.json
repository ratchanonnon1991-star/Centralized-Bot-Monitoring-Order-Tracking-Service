{
  "name": "oxide-bot-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Centralized Bot Monitoring & Order Tracking Service",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "tsc -p tsconfig.build.json && node dist/src/main.js",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "node dist/scripts/migrate.js",
    "agent": "node dist/agent/bot-agent.js",
    "agents": "node dist/scripts/run-agents.js",
    "simulator": "node simulator/server.js",
    "test": "jest -c jest.config.js",
    "test:e2e": "jest -c jest.e2e.config.js --runInBand",
    "test:all": "pnpm test && pnpm test:e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-ws": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.6",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.3"
  }
}
